rules_version = '2';

// Suggested Firestore security rules for KabbirMart.
// Copy these into Firebase Console → Firestore Database → Rules.
//
// Model: anyone can read products/settings (public storefront) and create
// an order (checkout). Only a signed-in user (your admin account) can
// write products/settings or read/update orders.

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
